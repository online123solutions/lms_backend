# Django
SECRET_KEY=your-staging-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-staging-domain.com
DJANGO_SETTINGS_MODULE=lms.settings.staging

# Database (Docker PostgreSQL service)
DB_NAME=lms_staging
DB_USER=lms_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# These mirror DB_* above — required by the postgres Docker image to init the DB
POSTGRES_DB=lms_staging
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=your-db-password

# Redis (points to the redis service in docker-compose)
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your@email.com

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Storage paths (mapped to Docker volumes)
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
